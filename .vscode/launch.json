  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File with Arguments",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "args": [
        "-i",
        "sample_audio/tijucos-no-dia-que-de.mp3",
        "-t",
        "demucs", // Or "spleeter"
        "--detect-instruments"
      ]
    }
  ]
}
